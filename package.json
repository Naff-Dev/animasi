  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/captions": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/three": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "gsap": "3.13.0",
    "mediabunny": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/three": "0.178.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "start": "tsx scripts/dev-all.ts",
    "dev": "tsx scripts/dev-all.ts",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "install:mcp": "npm --prefix mcp/flow-mcp install && npm --prefix mcp/aistudio-tts-mcp install",
    "build:mcp": "npm --prefix mcp/flow-mcp run build",
    "build:character": "tsx scripts/build-character-assets.ts",
    "build:viewer": "node scripts/build-viewer.mjs",
    "viewer": "node scripts/serve-viewer.mjs",
    "build:social": "node scripts/build-social.mjs",
    "social": "tsx scripts/social-server.ts",
    "build:audio": "tsx scripts/generate-audio-assets.ts",
    "render:preview": "remotion still StickmanPreview public/character/it-support-stickman/previews/character-preview.png --gl=angle",
    "render:ep01": "remotion render Episode01 out/SATU-HARI-SATU-FAKTA-IT-SUPPORT-EP01.mp4 --codec=h264 --audio-codec=aac --gl=angle",
    "render:ep02": "remotion render Episode02 out/SATU-HARI-SATU-FAKTA-IT-SUPPORT-EP02.mp4 --codec=h264 --audio-codec=aac --gl=angle",
    "render:ep03": "remotion render Episode03 out/SATU-HARI-SATU-FAKTA-IT-SUPPORT-EP03.mp4 --codec=h264 --audio-codec=aac --gl=angle",
    "render:ep04": "remotion render Episode04 out/SATU-HARI-SATU-FAKTA-IT-SUPPORT-EP04.mp4 --codec=h264 --audio-codec=aac --gl=angle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
